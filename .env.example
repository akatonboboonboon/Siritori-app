# Local development can omit these values and use the ignored SQLite database.
# Render production must configure every value in its dashboard.
APP_ENV=development
DATABASE_URL=sqlite+pysqlite:///./siritori-dev.db
DIRECT_DATABASE_URL=sqlite+pysqlite:///./siritori-dev.db
NICEGUI_STORAGE_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Optional comma-separated existing app usernames allowed to review requests.
ADMIN_USERNAMES=
SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
